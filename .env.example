# Local dev and Vercel server-side secrets (never commit real keys).
OPENROUTER_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_SYNC_PROFILE_ID=
# Public canonical Dicta app origin for Supabase password recovery redirects.
# Use the public production app URL, not a protected Vercel preview URL.
VITE_DICTA_AUTH_REDIRECT_ORIGIN=
# Public canonical Dicta app origin for in-app "Full app" navigation.
# Use the production app URL so preview deployments can return to prod.
VITE_DICTA_APP_ORIGIN=
SUPABASE_SERVICE_ROLE_KEY=
# Local-only Supabase sign-in account for E2E/manual verification. Do not expose via VITE_*.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_PROFILE_ID=
DICTA_OPENROUTER_MEMBER_CHAT_PER_HOUR=30
DICTA_OPENROUTER_ADMIN_CHAT_PER_HOUR=180
DICTA_OPENROUTER_MEMBER_JOBS_PER_HOUR=20
DICTA_OPENROUTER_ADMIN_JOBS_PER_HOUR=120
