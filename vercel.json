{
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "functions": {
    "api/auth/*.js": {
      "maxDuration": 10
    },
    "api/openrouter/*.js": {
      "maxDuration": 30
    }
  }
}
