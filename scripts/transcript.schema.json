{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DictaTranscript",
  "type": "object",
  "required": ["words"],
  "properties": {
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["word", "start", "end"],
        "properties": {
          "word": { "type": "string", "minLength": 1 },
          "start": { "type": "number", "minimum": 0 },
          "end": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
